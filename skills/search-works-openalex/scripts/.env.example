# Optionnel — clé OpenAlex. Sans elle le budget quotidien est de 0,10 $/jour ;
# une clé gratuite le porte à 1 $/jour. Le « polite pool » et `mailto` n'existent
# plus depuis février 2026. https://help.openalex.org/api/authentication/
OPENALEX_API_KEY=

# Optionnel — base de l'API, pour un miroir ou un proxy.
# Défaut : https://api.openalex.org
OPENALEX_API_URL=
