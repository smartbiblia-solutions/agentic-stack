# Copy to .env. Endpoint and credential only — the timeout, the retry count and
# the backoff are constants in cli.py, and every classification parameter is a
# flag.

# Where the humatheque-dewey-classifier-api service runs. The default is the
# public SmartBibl.IA deployment; point this at your own to keep texts in house.
DEWEY_API_URL=https://dewey-classifier.smartbiblia.fr

# Must match the API's CLASSIFICATION_API_KEY. Leave empty if it runs without
# auth, which the public deployment currently does.
DEWEY_API_KEY=
