# Copy to mcp/.env before running `docker compose -f mcp/compose.yml up`.
# Endpoints and credentials only — timeouts, retries and backoff are CLI flags
# on each server (see `uv run mcp_server.py --help`), not deployment settings.

# ── All servers ───────────────────────────────────────────────────────────────
# Stateless HTTP: a new transport per request, so no session is pinned to a
# replica. Set to true when running several replicas behind a load balancer.
MCP_STATELESS=false

# ── OpenAlex ──────────────────────────────────────────────────────────────────
OPENALEX_API_KEY=

# ── Primo ─────────────────────────────────────────────────────────────────────
PRIMO_API_KEY=
PRIMO_REGION=eu
PRIMO_VID=
PRIMO_TAB=
PRIMO_SCOPE=
PRIMO_INST=
PRIMO_LANG=en

# ── IdRef resolver API ───────────────────────────────────────────────────
# Base URL of your idref-resolver-api deployment, and its key if it
# enforces one. The key is sent as X-API-Key and is never a tool argument.
IDREF_API_URL=http://localhost:8000
IDREF_API_KEY=

# ── Recherche Data Gouv ───────────────────────────────────────────────────────
# Optional: point the server at another Dataverse instance.
RECHERCHE_DATA_GOUV_API_URL=https://entrepot.recherche.data.gouv.fr/api

# ── Sudoc SRU ─────────────────────────────────────────────────────────────────
# None. The Sudoc SRU service is public and anonymous.

# ── HAL ───────────────────────────────────────────────────────────────────────
# None. The CCSD search and reference APIs are public and anonymous.
